# ResQ-AI Backend Environment Variables (for running uvicorn / the worker outside Docker).
# docker compose reads the repo-root .env instead. Never commit a filled-in .env.
ENVIRONMENT=development
AWS_REGION=us-east-1

# True: zero-cost offline mode (in-memory store, simulated AWS, inline message processing).
# Real deployments set MOCK_AWS=False. Set AWS_ENDPOINT_URL to use the Floci emulator instead.
MOCK_AWS=True
# AWS_ENDPOINT_URL=http://localhost:4566

# Demo data: the API seeds demo doctors/cases; the worker must use False. DEMO_MODE pads analytics.
SEED_DEMO_DATA=True
DEMO_MODE=False

# Amazon Bedrock models (primary, then fallback, then the keyword classifier)
BEDROCK_MODEL_ID=anthropic.claude-5-5-sonnet-2026
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-pro-v1:0

# Triage agent: "local" (Strands in-process) or "agentcore" (AgentCore Runtime)
AGENT_BACKEND=local
# AGENTCORE_RUNTIME_ARN=
# AGENTCORE_GATEWAY_URL=

# DynamoDB & S3
DYNAMODB_TABLE_NAME=ResQTable
S3_AUDIO_BUCKET=resq-raw-audio-vault

# Amazon Transcribe (real AWS only)
TRANSCRIBE_TIMEOUT_SECONDS=60
TRANSCRIBE_POLL_INTERVAL_SECONDS=2
# TRANSCRIBE_LANGUAGE_OPTIONS=hi-IN,en-US,en-IN

# WhatsApp: "meta" (Meta Cloud API, local dev) or "eum_social" (AWS End User Messaging Social).
# With MOCK_AWS=True and no Meta credentials, a mock provider prints outbound messages.
WHATSAPP_PROVIDER=meta
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=resq_local_verify_token
# Meta app secret: enables the X-Hub-Signature-256 check on POST /api/v1/webhook
WHATSAPP_APP_SECRET=
# eum_social only: AWS phone number ID ("phone-number-id-...")
EUM_SOCIAL_PHONE_NUMBER_ID=
# Approved template that sends the patient's shared location to the emergency contact
# (scripts/create_whatsapp_templates.py creates it). Body: {{1}} patient name, {{2}} map link.
WHATSAPP_LOCATION_TEMPLATE_NAME=resq_emergency_location
WHATSAPP_LOCATION_TEMPLATE_LANGUAGE=en

# Queues and portal fan-out (resolved by name on Floci; set the URL/ARN on AWS)
WEBHOOK_QUEUE_NAME=resq-webhook-queue
# WEBHOOK_QUEUE_URL=
# PORTAL_EVENTS_TOPIC_ARN=

# Telephony (Amazon Connect)
CONNECT_INSTANCE_ID=00000000-0000-0000-0000-000000000000
CONNECT_FLOW_ID=00000000-0000-0000-0000-000000000000
CONNECT_SOURCE_PHONE_NUMBER=+18005550199
# No-doctor alerts (ADMIN-1): administrators called when an ESI 1-2 case has no doctor
# (comma-separated E.164; empty = portal alert only). Simulated outside real AWS.
# ADMIN_ALERT_PHONE_NUMBERS=+923001234567   # besides the administrators added in the portal (ADMIN-2)
# DOC-8: a newly registered doctor confirms their WhatsApp number (template quick replies) before
# getting offers; False trusts numbers as entered.
# DOCTOR_NUMBER_CONFIRMATION_ENABLED=True
# WHATSAPP_DOCTOR_CONFIRM_TEMPLATE_NAME=resq_doctor_confirm_number
# Doctors on WhatsApp (DOC-*): relay to the patient and "@resq" commands; False = use the portal.
# DOCTOR_WHATSAPP_RELAY_ENABLED=True

# Video (Chime): auto | mock | aws. Patient links need a public https PORTAL_BASE_URL.
CHIME_MODE=auto
PORTAL_BASE_URL=http://localhost:5173

# Portal auth (Cognito). Keep False locally.
AUTH_ENABLED=False
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=us-east-1
