# ResQ-AI portal build settings (Vite inlines VITE_* at build time).
# Local dev: copy to .env.local (git-ignored). Docker: pass as --build-arg (see Dockerfile).

# Cognito sign-in (UI-2). false = no login, every visitor is a local administrator
# (matches the backend's AUTH_ENABLED=False). Turn both on together.
VITE_AUTH_ENABLED=false

# Hosted UI domain: full URL, host name, or just the domain prefix
# (e.g. resq-ai-portal -> https://resq-ai-portal.auth.<region>.amazoncognito.com).
VITE_COGNITO_DOMAIN=
# Public app client (no client secret), authorization code grant, scopes openid email profile.
VITE_COGNITO_CLIENT_ID=
# Must be listed in the app client's callback URLs. Defaults to <current origin>/.
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
# Optional: must be listed in the app client's sign-out URLs. Defaults to the redirect URI's origin + /.
VITE_COGNITO_LOGOUT_URI=
VITE_AWS_REGION=us-east-1
# Informational (the backend verifies tokens against COGNITO_USER_POOL_ID).
VITE_COGNITO_USER_POOL_ID=
