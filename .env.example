# ResQ-AI root environment file, read by docker compose.
# Copy to .env and fill in. Never commit .env.

# WhatsApp provider: "meta" (Meta Cloud API, local dev via ngrok) or "eum_social"
# (AWS End User Messaging Social, production). Leave the Meta values empty to run
# with the mock provider (outbound messages are printed instead of sent).
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=resq_local_verify_token

# Only used when WHATSAPP_PROVIDER=eum_social (AWS phone number ID, "phone-number-id-...")
EUM_SOCIAL_PHONE_NUMBER_ID=
